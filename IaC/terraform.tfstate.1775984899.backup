            ],
            "primary_network_interface_id": "eni-0fa07237a573ef5a9",
            "private_dns": "ip-10-0-1-25.ap-northeast-1.compute.internal",
            "private_dns_name_options": [
              {
                "enable_resource_name_dns_a_record": false,
